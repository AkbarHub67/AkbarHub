StaminaTab:CreateButton({
    Name = "Scan Stamina System",
    Callback = function()
        local found = {}

        for _,obj in ipairs(LP:GetDescendants()) do
            local name = string.lower(obj.Name)

            if string.find(name,"stamina",1,true)
                or string.find(name,"energy",1,true)
                or string.find(name,"sprint",1,true) then

                table.insert(found,
                    obj:GetFullName() ..
                    " [" .. obj.ClassName .. "]"
                )
            end
        end

        for name,value in pairs(LP:GetAttributes()) do
            local lower = string.lower(name)

            if string.find(lower,"stamina",1,true)
                or string.find(lower,"energy",1,true) then

                table.insert(found,
                    "Attribute: " .. name ..
                    " = " .. tostring(value)
                )
            end
        end

        for _,result in ipairs(found) do
            print("[AKBARHUB STAMINA] " .. result)
        end

        Rayfield:Notify({
            Title = "Stamina Scanner",
            Content = #found > 0
                and "Found " .. #found .. " stamina entries. Check Output."
                or "No stamina entries found.",
            Duration = 5
        })
    end
})

--==================================================
-- MAIN LOOP
--==================================================

local ScanTimer = 0

RunService.Heartbeat:Connect(function(dt)
    local character = LP.Character
    local root = character and
        character:FindFirstChild("HumanoidRootPart")

    if not root then return end

    ScanTimer += dt

    if ScanTimer >= 0.5 then
        ScanTimer = 0

        for category,enabled in pairs(Settings) do
            if enabled and Names[category] then
                for _,obj in ipairs(Workspace:GetDescendants()) do
                    if obj.Name == Names[category] then
                        CreateESP(obj,category)
                    end
                end
            end
        end

        if Settings.Code then
            ScanCodes()
        end
    end

    -- UPDATE DISTANCE
    for category,objects in pairs(Objects) do
        for obj,data in pairs(objects) do
            if not obj:IsDescendantOf(Workspace)
                or not data.Part.Parent
                or not Settings[category] then

                if data.Highlight then
                    data.Highlight:Destroy()
                end

                if data.Billboard then
                    data.Billboard:Destroy()
                end

                objects[obj] = nil
            else
                local distance =
                    (root.Position-data.Part.Position).Magnitude

                data.Label.Text = string.format(
                    "%s\n%.0f STUDS",
                    category == "Code"
                        and "PASSCODE NOTE"
                        or string.upper(category),
                    distance
                )
            end
        end
    end
end)

