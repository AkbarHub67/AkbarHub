--==================================================
-- AUTO PROMPT
--==================================================

local AutoPromptEnabled = false
local OriginalPromptDuration = {}

local function UpdatePrompts()
    for _,prompt in ipairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            if AutoPromptEnabled then
                if OriginalPromptDuration[prompt] == nil then
                    OriginalPromptDuration[prompt] =
                        prompt.HoldDuration
                end

                prompt.HoldDuration = 0
            else
                if OriginalPromptDuration[prompt] ~= nil then
                    prompt.HoldDuration =
                        OriginalPromptDuration[prompt]

                    OriginalPromptDuration[prompt] = nil
                end
            end
        end
    end
end

PromptTab:CreateToggle({
    Name = "Auto Prompt Instant",
    CurrentValue = false,
    Callback = function(value)
        AutoPromptEnabled = value
        UpdatePrompts()
    end
})

Workspace.DescendantAdded:Connect(function(obj)
    if AutoPromptEnabled and obj:IsA("ProximityPrompt") then
        OriginalPromptDuration[obj] = obj.HoldDuration
        obj.HoldDuration = 0
    end
end)

--==================================================
-- AUTO KEY INVENTORY SCANNER
--==================================================

local function GetKeyCount()
    local count = 0

    local backpack = LP:FindFirstChild("Backpack")
    local character = LP.Character

    for _,container in ipairs({backpack,character}) do
        if container then
            for _,obj in ipairs(container:GetChildren()) do
                if obj:IsA("Tool")
                    and string.find(
                        string.lower(obj.Name),
                        "key",1,true
                    ) then
                    count += 1
                end
            end
        end
    end

    return count
end

local function FindKey()
    for _,obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Key" then
            local part = GetPart(obj)

            if part then
                return obj,part
            end
        end
    end
end

KeyTab:CreateToggle({
    Name = "Auto Key + Auto Return",
    CurrentValue = false,
    Callback = function(value)
        Settings.AutoKey = value

        if value and not FirstLocation then
            Settings.AutoKey = false

            Rayfield:Notify({
                Title = "Auto Key",
                Content = "Save First Location First!",
                Duration = 3
            })
            return
        end

        if not value then return end

        task.spawn(function()
            while Settings.AutoKey do
                local target,part = FindKey()

                if not target then
                    task.wait(1)
                    continue
                end

                local beforeCount = GetKeyCount()

                local character = LP.Character
                local root = character and
                    character:FindFirstChild("HumanoidRootPart")

                if not root then
                    task.wait(1)
                    continue
                end

                -- TELEPORT TO KEY
                root.CFrame = part.CFrame * CFrame.new(0,3,0)

                -- WAIT FOR INVENTORY CHANGE
                local elapsed = 0
                local collected = false

                while Settings.AutoKey and elapsed < 30 do
                    task.wait(0.25)
                    elapsed += 0.25

                    if GetKeyCount() > beforeCount then
                        collected = true
                        break
                    end
                end

                -- RETURN AFTER COLLECTION
                if collected and Settings.AutoKey then
                    character = LP.Character
                    root = character and
                        character:FindFirstChild("HumanoidRootPart")

                    if root and FirstLocation then
                        root.CFrame = FirstLocation

                        Rayfield:Notify({
                            Title = "Auto Key",
                            Content = "Key Collected! Returned!",
                            Duration = 2
                        })
                    end
                end

                task.wait(1)
            end
        end)
    end
})

--==================================================
-- FULLBRIGHT
--==================================================

local OriginalLighting

local function EnableFullBright()
    if not OriginalLighting then
        OriginalLighting = {
            Brightness = Lighting.Brightness,
            ClockTime = Lighting.ClockTime,
            FogEnd = Lighting.FogEnd,
            GlobalShadows = Lighting.GlobalShadows,
            Ambient = Lighting.Ambient,
            OutdoorAmbient = Lighting.OutdoorAmbient,
            ExposureCompensation =
                Lighting.ExposureCompensation
        }
    end

    Lighting.Brightness = 3
    Lighting.ClockTime = 14
    Lighting.FogEnd = 100000
    Lighting.GlobalShadows = false
    Lighting.Ambient = Color3.new(1,1,1)
    Lighting.OutdoorAmbient = Color3.new(1,1,1)
    Lighting.ExposureCompensation = 0
end

local function DisableFullBright()
    if not OriginalLighting then return end

    for property,value in pairs(OriginalLighting) do
        Lighting[property] = value
    end

    OriginalLighting = nil
end

VisualTab:CreateToggle({
    Name = "FullBright",
    CurrentValue = false,
    Callback = function(value)
        if value then
            EnableFullBright()
        else
            DisableFullBright()
        end
    end
})

